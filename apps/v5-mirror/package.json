{
  "name": "@muonhub/v5-mirror",
  "version": "6.0.0-alpha.1.8",
  "private": true,
  "description": "Read-only mirror of a public v5 profile (munhub-1) into a v6 stream on the Firebase emulators, for the M2 demo; never writes to v5",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/main.js",
    "seed-demo": "node dist/seed-demo.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@muonhub/data-provider": "workspace:*",
    "@muonhub/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
