{
  "name": "@muonhub/agent",
  "version": "6.0.0-alpha.1.6",
  "private": true,
  "description": "MuonHub agent — headless Node.js 24 daemon that reads devices over serial, keeps every raw line locally, and syncs complete-minute records (spec 0087, ADR-007)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "muonhub-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@muonhub/data-provider": "workspace:*",
    "@muonhub/physics": "workspace:*",
    "@muonhub/shared": "workspace:*",
    "serialport": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@muonhub/simulator": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
