{
  "name": "@muonhub/web",
  "version": "6.0.0-alpha.2.2.1",
  "private": true,
  "description": "MuonHub web app — Next.js static export: accounts, stations, dashboards, public site (spec 0088)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "test": "vitest run",
    "e2e": "XDG_CONFIG_HOME=\"$PWD/e2e/.state/config\" NO_UPDATE_NOTIFIER=1 ../agent/node_modules/.bin/firebase emulators:exec --only auth,firestore,database --project demo-muonhub --config ../../infra/firebase/firebase.json \"bash e2e/run.sh\"",
    "lint": "eslint src e2e/*.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "clean": "rm -rf .next out *.tsbuildinfo"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@muonhub/data-provider": "workspace:*",
    "@muonhub/shared": "workspace:*",
    "@muonhub/ui": "workspace:*",
    "geist": "^1.9.1",
    "lucide-react": "~1.66.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.32",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
