# Firebase credentials (NEVER commit these!)
private/
firebase_credentials.json
**/firebase_credentials.json
*.pem
*.key
*.p12

# Firebase cache
.firebase/

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node modules (if added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Windows Zone.Identifier files
*Zone.Identifier

# Logs
logs/
*.log

# Build outputs
dist/
build/
.tmp/
.next/
out/

# pnpm / Turborepo
.pnpm-store/
.turbo/

# Tauri build artifacts
src-tauri/target/

# SQLite databases (local agent data — backed up separately)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Test coverage
coverage/
*.lcov

# Misc
*.tsbuildinfo

# Personal Claude Code settings (machine-local permissions; never shared)
.claude/settings.local.json
