# MuonHub — environment variables template
# Copy to apps/web/.env.local (never commit .env.local or any real secret).
# Values come from the Firebase console → Project settings → Your apps → Web app (project `muonhub`).
# These web-client values are public by design; access is controlled by security rules and App Check.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Unused on the Spark plan (Cloud Storage requires Blaze); read only by first-attempt code.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Data provider implementation (only "firebase" exists).
NEXT_PUBLIC_ACTIVE_PROVIDER=firebase

# Service-account keys are never configured here: they live in the git-ignored private/ folder
# locally, and in CI secrets for automation (see docs/operations/ENVIRONMENTS.md).
